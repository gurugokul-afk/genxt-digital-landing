# =========================================================================
# ⚙️ GENXT DIGITAL PRODUCT & PAYMENT ENVIRONMENT CONFIGURATION
# =========================================================================

# Server Port
PORT=5000

# 💰 Product & Pricing Setup
PRODUCT_TITLE="GenXt Digital Creator & Monetization OS"
PRODUCT_PRICE=499
PRODUCT_FILE_NAME="GenXt_Digital_OS_Complete_Vault_v2.zip"

# 💳 Payment Gateway / UPI Configuration
# Replace with your actual UPI ID (Google Pay, PhonePe, Paytm, BHIM)
UPI_ID="genxtdigital@okhdfcbank"
MERCHANT_NAME="GenXt Digital"

# Optional: If you host your file on Google Drive, AWS S3, or Dropbox,
# paste the link below. If left empty, the server automatically serves the local zip file!
EXTERNAL_DOWNLOAD_URL=""

# 📧 Email Delivery (Nodemailer SMTP Configuration)
# OPTION 1: Gmail SMTP (Fastest & easiest)
# Create an App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# OPTION 2: Standard SMTP (Hostinger, cPanel, Zoho, Brevo, AWS SES, Resend)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"GenXt Digital" <support@genxt.digital>'

# Note: If no SMTP credentials are provided above, the server automatically
# generates an Ethereal test inbox so you can test email delivery instantly without setup!

# 💬 Customer Support Contact
SUPPORT_EMAIL="support@genxt.digital"
SUPPORT_PHONE="+91 98765 43210"
SUPPORT_WHATSAPP="919876543210"
